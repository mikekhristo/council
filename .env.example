# Council — bring-your-own-key configuration
#
# Copy this file to `.env.local` and fill in keys for any providers you
# want to use. Council needs at least TWO configured providers to start a
# deliberation.
#
# All keys are optional individually — Council degrades gracefully and
# only shows providers whose keys are set. Missing keys are surfaced in
# the UI rather than crashing the app.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# xAI (Grok) — https://console.x.ai
XAI_API_KEY=

# Optional — override the SQLite database file path. Defaults to ./council.db
# COUNCIL_DB_PATH=./council.db
